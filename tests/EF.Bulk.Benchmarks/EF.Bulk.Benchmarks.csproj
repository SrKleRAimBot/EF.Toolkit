<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires optimized builds to produce meaningful numbers. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EF.Bulk/EF.Bulk.csproj" />
    <ProjectReference Include="../../src/EF.Bulk.PostgreSQL/EF.Bulk.PostgreSQL.csproj" />
    <ProjectReference Include="../../src/EF.Bulk.SqlServer/EF.Bulk.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

</Project>
