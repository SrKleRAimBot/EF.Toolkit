<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EF.Toolkit.Query/EF.Toolkit.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />

    <!--
      EF.Toolkit.Query is provider-neutral, so unlike the Bulk and Audit test projects it does not
      pick a provider up through a project reference. The unit tests still need real ones: they
      build a model against a connection string that never connects, which is how every test project
      here gets an IModel without a database.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!--
      A provider that maps a type EF has no value converter for. NodaTime's Instant and LocalDate go
      to timestamptz and date natively, which is the half of the cursor question the CLR type alone
      cannot answer.
    -->
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
  </ItemGroup>

</Project>
