<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires optimized builds to produce meaningful numbers. -->
    <Optimize>true</Optimize>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EF.Toolkit.Bulk/EF.Toolkit.Bulk.csproj" />
    <ProjectReference Include="../../src/EF.Toolkit.Bulk.PostgreSQL/EF.Toolkit.Bulk.PostgreSQL.csproj" />
    <ProjectReference Include="../../src/EF.Toolkit.Bulk.SqlServer/EF.Toolkit.Bulk.SqlServer.csproj" />
    <ProjectReference Include="../../src/EF.Toolkit.Bulk.MySql/EF.Toolkit.Bulk.MySql.csproj" />
    <ProjectReference Include="../../src/EF.Toolkit.Bulk.Sqlite/EF.Toolkit.Bulk.Sqlite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Testcontainers.MySql" />
    <PackageReference Include="MySql.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />

    <!--
      MySql.EntityFrameworkCore needs at least 10.0.1 of the relational layer, above the floor the
      libraries themselves declare, so the floor is lifted here rather than for every consumer.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="[10.0.1,11.0.0)" />
  </ItemGroup>

</Project>
