<Project>

  <!--
    The EF Core major this build targets. One source tree builds every supported major: pass
    -p:EfCoreMajor=11 to build, test and pack the EF Core 11 line. The default stays on the major
    master ships, so a plain `dotnet build` is unchanged.

    Each major still produces its own package version (10.x for EF Core 10, 11.x for EF Core 11)
    with its own framework and an EF range capped at the next major — the packages hook low-level
    services and must never resolve across an EF major, so this deliberately is not multi-targeting.
    EFCORE10 / EFCORE11 are defined for the rare source difference between majors.
  -->
  <PropertyGroup>
    <EfCoreMajor Condition="'$(EfCoreMajor)' == ''">10</EfCoreMajor>
    <EfCoreNextMajor>$([MSBuild]::Add($(EfCoreMajor), 1))</EfCoreNextMajor>
    <EfCoreRange>[$(EfCoreMajor).0.0,$(EfCoreNextMajor).0.0)</EfCoreRange>
    <!--
      Test-only floors. Oracle's MySQL provider needs 10.0.1 of the relational layer on EF Core 10,
      and on EF Core 11 has so far shipped only as a preview, which a range must name to admit.
    -->
    <MySqlEfCoreRange Condition="'$(EfCoreMajor)' == '10'">[10.0.1,11.0.0)</MySqlEfCoreRange>
    <MySqlEfCoreRange Condition="'$(EfCoreMajor)' != '10'">[$(EfCoreMajor).0.0-preview,$(EfCoreNextMajor).0.0)</MySqlEfCoreRange>
    <RelationalTestRange Condition="'$(EfCoreMajor)' == '10'">[10.0.1,11.0.0)</RelationalTestRange>
    <RelationalTestRange Condition="'$(EfCoreMajor)' != '10'">$(EfCoreRange)</RelationalTestRange>
    <DefineConstants>$(DefineConstants);EFCORE$(EfCoreMajor)</DefineConstants>
    <!--
      Restore output is per project, not per framework, so two majors sharing obj/ would overwrite
      each other's assets file on every switch. The non-default major restores beside it instead.
    -->
    <BaseIntermediateOutputPath Condition="'$(EfCoreMajor)' != '10'">obj/ef$(EfCoreMajor)/</BaseIntermediateOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net$(EfCoreMajor).0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!--
      Package IDs are dotted (EF.Toolkit.Bulk); the CLR namespace deliberately is not. A root
      namespace segment of "EF" would shadow EF Core's own EF class, breaking EF.Property and
      EF.Functions in any consumer file that imports ours.
    -->
    <RootNamespace>$(MSBuildProjectName.Replace('EF.Toolkit', 'EFToolkit'))</RootNamespace>
  </PropertyGroup>

  <!--
    EF.Toolkit.Bulk version-aligns with EF Core: the EF pin is a package-level decision, not a
    TFM-level one, so we do not multi-target a single package across EF majors.
      EfCoreMajor=10   -> EF.Toolkit.Bulk 10.x, net10.0, EF Core [10.0.0,11.0.0)  (default)
      EfCoreMajor=11   -> EF.Toolkit.Bulk 11.x, net11.0, EF Core [11.0.0,12.0.0)
      release/ef9      -> EF.Toolkit.Bulk  9.x, net8.0,  EF Core  [9.0.0,10.0.0)
    The hook signatures we depend on are identical across both majors, so the source is shared.
  -->
  <PropertyGroup>
    <VersionPrefix>$(EfCoreMajor).0.0</VersionPrefix>
    <VersionSuffix>alpha.7</VersionSuffix>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Jake Seracino</Authors>
    <Company>Jake Seracino</Company>
    <Product>EF.Toolkit</Product>
    <Copyright>Copyright (c) 2026 Jake Seracino</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SrKleRAimBot/EF.Toolkit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SrKleRAimBot/EF.Toolkit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!--
      Package projects set PackagePath="README.md" without a trailing separator. NuGet treats that
      as the complete destination path, renaming docs/bulk.md or docs/audit.md inside the package.
    -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!--
    One icon for the whole EF.Toolkit family. Unconditional because IsPackable is set by the
    project files, which are evaluated after this one — the non-packable projects simply never
    pack the item. assets/icon.svg is the source; icon.png is a 128x128 render of it.
  -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)assets/icon.png"
          Pack="true"
          PackagePath="\"
          Visible="false" />
  </ItemGroup>

  <PropertyGroup Label="Reproducible builds">
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

</Project>
