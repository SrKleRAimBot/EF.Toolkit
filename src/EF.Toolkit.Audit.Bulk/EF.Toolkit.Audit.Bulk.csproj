<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>EF.Toolkit.Audit.Bulk</PackageId>
    <PackageTags>entity-framework-core;efcore;audit;auditing;audit-trail;change-tracking;bulk;bulkinsert;performance</PackageTags>
    <Description>
      Joins EF.Toolkit.Audit to EF.Toolkit.Bulk. Captures audit entries for the explicit bulk API —
      which bypasses the change tracker and so is invisible to a SaveChanges interceptor — and
      writes those entries in bulk. Neither package depends on the other; install this to use both.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EF.Toolkit.Audit/EF.Toolkit.Audit.csproj" />
    <ProjectReference Include="../EF.Toolkit.Bulk/EF.Toolkit.Bulk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/audit-bulk.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EF.Toolkit.Audit.Tests" />
    <InternalsVisibleTo Include="EF.Toolkit.Audit.Equivalence" />
  </ItemGroup>

</Project>
