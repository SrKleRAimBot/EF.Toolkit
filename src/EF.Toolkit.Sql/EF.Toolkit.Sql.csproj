<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>EF.Toolkit.Sql</PackageId>
    <PackageTags>entity-framework-core;efcore;sql;views;materialized-views;stored-procedures;functions;row-level-security;rls;multi-tenant;session-context;migrations</PackageTags>
    <Description>
      The advanced SQL features EF Core leaves to raw strings. Views, materialized views, stored
      procedures and functions as definitions that render the right create and drop SQL for
      PostgreSQL, SQL Server, MySQL and SQLite — in migrations and at runtime alike. Row-level
      security policies and one-line tenant isolation, session context applied on every connection
      open, and parameterised procedure and function calls. Unsupported combinations throw rather
      than emit SQL that would be wrong.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/sql.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EF.Toolkit.Sql.Tests" />
    <InternalsVisibleTo Include="EF.Toolkit.Sql.Integration" />
  </ItemGroup>

</Project>
