<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>EF.Toolkit.Conventions</PackageId>
    <PackageTags>entity-framework-core;efcore;soft-delete;softdelete;timestamps;created-at;updated-at;query-filter</PackageTags>
    <Description>
      Entity conventions EF Core leaves to every application: soft delete — a Remove() that marks the
      row instead of deleting it, hidden by a named query filter, with restore, hard delete and
      set-based variants — and created/updated timestamps maintained on every save. Provider-neutral.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/conventions.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EF.Toolkit.Conventions.Tests" />
  </ItemGroup>

</Project>
