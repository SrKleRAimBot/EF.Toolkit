<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>EF.Toolkit.Audit.SqlServer</PackageId>
    <PackageTags>entity-framework-core;efcore;audit;auditing;audit-trail;change-tracking;history;compliance;sqlserver</PackageTags>
    <Description>
      SQL Server provider for EF.Toolkit.Audit. Stores the audit payload as validated JSON, with
      optional persisted computed columns so a hot JSON path can be indexed.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../EF.Toolkit.Audit/EF.Toolkit.Audit.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/audit-sqlserver.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EF.Toolkit.Audit.Tests" />
    <InternalsVisibleTo Include="EF.Toolkit.Audit.Equivalence" />
  </ItemGroup>

</Project>
