<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>EF.Toolkit.Bulk</PackageId>
    <PackageTags>entity-framework-core;efcore;bulk;bulkinsert;bulkupdate;bulkdelete;bulkmerge;performance</PackageTags>
    <Description>
      High-performance bulk operations for EF Core. Accelerates SaveChanges() transparently and
      adds an explicit BulkInsert/Update/Merge/Delete API, while preserving change tracking and
      EF semantics. Provider-neutral core; install EF.Toolkit.Bulk.SqlServer or EF.Toolkit.Bulk.PostgreSQL.
    </Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../docs/bulk.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EF.Toolkit.Bulk.SqlServer" />
    <InternalsVisibleTo Include="EF.Toolkit.Bulk.PostgreSQL" />
    <InternalsVisibleTo Include="EF.Toolkit.Bulk.Tests" />
    <InternalsVisibleTo Include="EF.Toolkit.Bulk.Equivalence" />
  </ItemGroup>

</Project>
