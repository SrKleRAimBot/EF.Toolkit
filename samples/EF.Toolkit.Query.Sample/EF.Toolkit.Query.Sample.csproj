<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/EF.Toolkit.Query/EF.Toolkit.Query.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF.Toolkit.Query is provider-neutral, so the sample picks a provider for itself. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />

    <!-- So the sample runs with no setup: it starts its own PostgreSQL when given no connection string. -->
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
